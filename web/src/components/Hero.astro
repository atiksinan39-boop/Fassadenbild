---
import { Picture } from 'astro:assets';
import heroImg from '../assets/hero.jpg';

const title = 'Wände dürfen selbst das Bild sein.';
const words = title.split(' ');
---
<section class="hero on-dark" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__media" data-hero-media aria-hidden="true">
    <div class="hero__drift">
      <Picture
        src={heroImg}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600]}
        sizes="100vw"
        alt=""
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__body">
    <p class="label hero__kicker" data-hero-fade>Wand · Boden · Fassade</p>
    <h1 class="hero__title" id="hero-title">
      {words.map((w, i) => (
        <>
          <span class="w"><span class="wi">{w}</span></span>{i < words.length - 1 ? ' ' : ''}
        </>
      ))}
    </h1>

    <div class="hero__row">
      <p class="hero__intro" data-hero-fade>CoverCraft bringt Bildkunst dauerhaft auf Fassade, Innenwand und Nassraum. Gedruckt in einer Bahn, verklebt mit einem patentierten Verfahren. Ohne Bohren, ohne Abriss.</p>
      <div class="hero__ctas" data-hero-fade>
        <a class="btn-primary" href="#kontakt">Technischen Musterfächer anfordern
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h12M10 4l5 5-5 5"></path></svg>
        </a>
        <a class="text-link" href="#system">System ansehen</a>
      </div>
    </div>

    <!-- Maßlinie -->
    <div class="measure" aria-hidden="true" data-measure>
      <span class="measure__tick"></span>
      <span class="measure__line measure__line--l"></span>
      <span class="measure__text">MAX. BAHNBREITE 500 CM<span class="measure__more"> · EINE BAHN, KEINE FUGE</span></span>
      <span class="measure__line measure__line--r"></span>
      <span class="measure__tick"></span>
    </div>

    <div class="stats-wrap" data-stats>
    <span class="stats__rule" aria-hidden="true"></span>
    <dl class="stats">
      <div class="stat">
        <dt class="label label--s">Brandklasse Außentapete</dt>
        <dd>B-s1, d0 <small>IBS Linz</small></dd>
      </div>
      <div class="stat">
        <dt class="label label--s">Bahnbreite</dt>
        <dd><span class="num" data-count="500">500</span> cm <small>außen · 300 cm innen</small></dd>
      </div>
      <div class="stat">
        <dt class="label label--s">Verfahren</dt>
        <dd>seit 2009 <small>patentiert</small></dd>
      </div>
      <div class="stat">
        <dt class="label label--s">Dokumentierte Projekte</dt>
        <dd><span class="num" data-count="40">40</span> <small>von 2 bis 1.100 m²</small></dd>
      </div>
    </dl>
    </div>
  </div>
</section>
