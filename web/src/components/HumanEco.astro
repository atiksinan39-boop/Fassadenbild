---
import { Picture } from 'astro:assets';
import { chapters } from '../data/chapters';
import { chapterImages } from './chapterImages';
---
<section class="humaneco" id="humaneco" aria-labelledby="he-title">
  <div class="wrap sec">
    <div class="humaneco__head">
      <div>
        <p class="label" style="margin-bottom:18px" data-reveal-label>05 — Manifest</p>
        <h2 class="humaneco__title" id="he-title" data-grow>HumanEco</h2>
        <p class="humaneco__sub" data-reveal-fade>in urbanen Habitaten</p>
      </div>
      <div data-reveal-fade>
        <p class="lead humaneco__intro">Human und Eco. Im Eco steckt das griechische oikos: das Haus, der Ort, an den der Mensch gehört. Unser Manifest kreativer Perspektiven fragt, wie Orte zu einem Zuhause werden. Oder eben nicht.</p>
        <p class="link-row">
          <a class="text-link" href="#kontakt">Manifest als PDF anfordern, 58 Seiten</a>
          <a class="text-link text-link--quiet" href="/humaneco">Manifest lesen</a>
        </p>
      </div>
    </div>
    <div class="cards" data-cards>
      {chapters.map((c) => (
        <a class="card" href={`/humaneco#kapitel-${c.id}`}>
          <span class:list={['card__media', { 'card__media--white': c.white }]}>
            <Picture src={chapterImages[c.img]} formats={['avif', 'webp']} widths={[400, 700, 1000]} sizes="(min-width: 1100px) 30vw, (min-width: 720px) 45vw, 100vw" alt={c.alt} />
          </span>
          <span class="label label--s">Kapitel {c.no}</span>
          <span class="card__title">{c.title}</span>
          <span class="card__text">{c.text}</span>
        </a>
      ))}
    </div>
  </div>
</section>
