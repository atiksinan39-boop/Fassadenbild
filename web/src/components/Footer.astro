---
import { u } from '../lib/url';
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
---
<footer class:list={['site-footer', 'on-dark', { 'site-footer--standalone': standalone }]}>
  <div class="wrap">
    <span>CoverCraft · Surface Design Engineering · Technologie &amp; Handwerk</span>
    <nav aria-label="Rechtliches">
      <a href={u('/kontakt')}>Kontakt</a><a href={u('/impressum')}>Impressum</a><a href={u('/datenschutz')}>Datenschutz</a>
    </nav>
  </div>
</footer>
