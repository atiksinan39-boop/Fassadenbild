---
const links = [
  { href: '#system', label: 'System', no: '01' },
  { href: '#einsatz', label: 'Einsatz', no: '02' },
  { href: '#referenzen', label: 'Referenzen', no: '04' },
  { href: '#humaneco', label: 'HumanEco', no: '05' },
];
---
<header class="site-nav" data-nav>
  <div class="site-nav__inner">
    <a class="brand" href="#top" aria-label="CoverCraft, zum Seitenanfang">
      <span class="brand__name">CoverCraft</span>
      <span class="brand__sub label">Surface Design Engineering</span>
    </a>
    <nav aria-label="Hauptnavigation">
      <ul class="site-nav__links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a class="nav-cta" href="#kontakt">Musterfächer anfordern</a></li>
      </ul>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
      <span data-menu-label>Menü</span><span class="menu-btn__icon" aria-hidden="true"></span>
    </button>
  </div>
  <div class="menu on-dark" id="menu" hidden data-menu>
    <nav aria-label="Menü">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}<span>{l.no}</span></a></li>)}
      </ul>
    </nav>
    <a class="btn-primary" href="#kontakt">Technischen Musterfächer anfordern</a>
  </div>
</header>
