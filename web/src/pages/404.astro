---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Seite nicht gefunden" cta="/kontakt" noindex>
  <PageHero label="Fehler 404" title="Hier ist keine Wand." intro="Die Seite gibt es nicht oder nicht mehr.">
    <p style="margin-top:28px"><a class="text-link" href="/">Zur Startseite</a></p>
  </PageHero>
  <Footer standalone slot="after" />
</Base>
