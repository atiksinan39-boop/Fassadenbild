---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Kontakt from '../components/Kontakt.astro';
import { chapters } from '../data/chapters';
import { chapterImages } from '../components/chapterImages';
import turm from '../assets/turm.jpg';
---
<Base title="HumanEco: das Manifest" description="HumanEco in urbanen Habitaten: das Manifest kreativer Perspektiven von R.C. Salih Atik. Wie Orte zu einem Zuhause werden.">
  <PageHero label="Manifest · in urbanen Habitaten" title="HumanEco" image={turm}
    intro="Human und Eco. Im Eco steckt das griechische oikos: das Haus, der Ort, an den der Mensch gehört. Unser Manifest kreativer Perspektiven fragt, wie Orte zu einem Zuhause werden. Oder eben nicht." />

  <div class="band band--white">
    <div class="wrap sec chapters">
      <nav class="chapters__toc" aria-label="Kapitel">
        <p class="label">Kapitel</p>
        <ol>
          {chapters.map((c) => <li><a href={`#kapitel-${c.id}`}><span class="mono">{c.no}</span>{c.title}</a></li>)}
        </ol>
        <a class="text-link" href="#kontakt">Manifest als PDF anfordern, 58 Seiten</a>
      </nav>
      <div class="chapters__list">
        {chapters.map((c) => (
          <article class="chapter" id={`kapitel-${c.id}`} aria-labelledby={`k-${c.id}`}>
            <div class:list={['chapter__media', { 'chapter__media--white': c.white }]} data-wipe>
              <Picture src={chapterImages[c.img]} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 55vw, 100vw" alt={c.alt} />
            </div>
            <p class="label" data-reveal-label>Kapitel {c.no}</p>
            <h2 class="h-sec" id={`k-${c.id}`} data-reveal-lines>{c.title}</h2>
            <blockquote class="chapter__quote" data-ink>{c.text}</blockquote>
            <p class="ph">[KAPITELTEXT, GEKÜRZT AUS DEM MANIFEST]</p>
          </article>
        ))}
      </div>
    </div>
  </div>

  <Kontakt />
</Base>
